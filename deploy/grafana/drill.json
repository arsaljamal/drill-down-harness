{
 "uid": "drill",
 "title": "Drill Down Harness",
 "tags": [
  "drill"
 ],
 "refresh": "10s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "schemaVersion": 39,
 "panels": [
  {
   "type": "text",
   "title": "",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 3
   },
   "options": {
    "mode": "markdown",
    "content": "### How the investigator is doing\nEach **run** is one investigation. Green numbers are good. **Sent back** counts reports the harness rejected as too early. Click a run in *Recent runs* (bottom) to see its full timeline."
   }
  },
  {
   "type": "stat",
   "title": "Runs",
   "description": "Investigations finished in the selected time range.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 3,
    "w": 4,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    }
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(max_over_time(drill_runs_total[$__range]))",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Finished normally",
   "description": "Share of runs that ended with a report, not a limit (time, turns, tokens) or an error.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 4,
    "y": 3,
    "w": 4,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.7
       },
       {
        "color": "green",
        "value": 0.9
       }
      ]
     }
    }
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(sum(max_over_time(drill_runs_total{stop=\"done\"}[$__range])) or vector(0)) / sum(max_over_time(drill_runs_total[$__range]))",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Typical run time",
   "description": "Median minutes from page to report.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 3,
    "w": 4,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "decimals": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 180
       },
       {
        "color": "red",
        "value": 600
       }
      ]
     }
    }
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (max_over_time(drill_run_duration_seconds_bucket[$__range])))",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Checks per run",
   "description": "Average number of tool calls (queries) per investigation.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 3,
    "w": 4,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    }
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(max_over_time(drill_tool_calls_total[$__range])) / sum(max_over_time(drill_runs_total[$__range]))",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Sent back",
   "description": "Reports the harness refused because the evidence was not there yet.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 3,
    "w": 4,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       }
      ]
     }
    }
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(max_over_time(drill_gate_sendbacks_total[$__range])) or vector(0)",
     "refId": "A"
    }
   ]
  },
  {
   "type": "stat",
   "title": "Tokens per run",
   "description": "Model input + output tokens per investigation (cost driver for hosted models).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 20,
    "y": 3,
    "w": 4,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 1,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    }
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(max_over_time(drill_tokens_total[$__range])) / sum(max_over_time(drill_runs_total[$__range]))",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "How runs ended (runs active in the last 10 min)",
   "description": "done = wrote a report. Anything else means it hit a limit or failed.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 15,
      "stacking": {
       "mode": "normal"
      }
     }
    }
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (stop) (max_over_time(drill_runs_total[10m]))",
     "legendFormat": "{{stop}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Run time (p50 / p95)",
   "description": "How long an investigation takes, page to report.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 15,
      "stacking": {
       "mode": "none"
      }
     }
    }
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (max_over_time(drill_run_duration_seconds_bucket[30m])))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (max_over_time(drill_run_duration_seconds_bucket[30m])))",
     "legendFormat": "p95",
     "refId": "B"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Which tools it uses",
   "description": "Tool calls by runs active in the last 10 minutes, by tool.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 15,
      "stacking": {
       "mode": "normal"
      }
     }
    }
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (tool) (max_over_time(drill_tool_calls_total[10m]))",
     "legendFormat": "{{tool}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Tool errors",
   "description": "Failed tool calls (bad queries, timeouts). The model sees the error and can retry.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 15,
      "stacking": {
       "mode": "none"
      }
     }
    }
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (tool) (max_over_time(drill_tool_calls_total{outcome=\"error\"}[10m]))",
     "legendFormat": "{{tool}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Slowest parts (p95)",
   "description": "Where time goes: waiting for the model, or for tools.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 15,
      "stacking": {
       "mode": "none"
      }
     }
    }
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(drill_model_duration_seconds_bucket[10m])))",
     "legendFormat": "model thinking",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le, tool) (rate(drill_tool_duration_seconds_bucket[10m])))",
     "legendFormat": "tool: {{tool}}",
     "refId": "B"
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Tokens",
   "description": "Model tokens used by runs active in the last 10 minutes.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 15,
      "stacking": {
       "mode": "normal"
      }
     }
    }
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (kind) (max_over_time(drill_tokens_total[10m]))",
     "legendFormat": "{{kind}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "table",
   "title": "Recent runs (click one for its timeline)",
   "datasource": {
    "type": "tempo",
    "uid": "tempo"
   },
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 24,
    "h": 9
   },
   "targets": [
    {
     "datasource": {
      "type": "tempo",
      "uid": "tempo"
     },
     "queryType": "traceql",
     "query": "{resource.service.name=\"drill-down-harness\" && name=\"drill.run\"}",
     "limit": 30,
     "refId": "A"
    }
   ]
  }
 ]
}